# Local development (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Angkutantoyib?schema=public"

# Production / Railway — replace with Railway Postgres URL (same postgresql provider)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# UploadThing (optional — https://uploadthing.com/dashboard)
# When unset, photos save via /api/upload/local → public/uploads/field
# UPLOADTHING_TOKEN="sk_live_..."
# NEXT_PUBLIC_UPLOADTHING="true"

