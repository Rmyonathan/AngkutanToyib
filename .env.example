# =============================================================================
# Railway production — paste these into the Railway service Variables tab
# =============================================================================

# PostgreSQL — Railway Postgres plugin → Connect → copy "DATABASE_URL"
# Example: postgresql://postgres:PASSWORD@HOST.railway.internal:5432/railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# NextAuth — REQUIRED in production
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="paste-output-of-openssl-rand-base64-32-here"

# NextAuth — set to your public Railway domain AFTER first deploy
# Example: https://angkutan-toyib-production.up.railway.app
NEXTAUTH_URL="https://your-app-name.up.railway.app"

# UploadThing (optional — https://uploadthing.com/dashboard)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"
# uploadthing v7 SDK also accepts this single token (same value as secret key in dashboard)
UPLOADTHING_TOKEN="sk_live_..."
# Enable UploadThing UI instead of local /api/upload/local fallback (when wired in UI)
# NEXT_PUBLIC_UPLOADTHING="true"

# =============================================================================
# Local development only (uncomment / copy to .env)
# =============================================================================
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Angkutantoyib?schema=public"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="any-long-random-string-for-local-dev"
