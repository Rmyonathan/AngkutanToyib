# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# env files (keep .env.example as template)
.env
.env.*
!.env.example

# vercel / railway
.vercel
.railway

