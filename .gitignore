*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# local field photo uploads (MVP fallback)
/public/uploads

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# local scratch scripts
/__*.mjs
/__*.cjs
